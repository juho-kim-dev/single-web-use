{
  "format": "paw-swu-pack",
  "schemaVersion": 1,
  "id": "container-demo",
  "version": "0.1.0",
  "name": "Synthetic bounded container reading",
  "scope": {
    "origin": "http://127.0.0.1:47832",
    "pathPrefix": "/",
    "conditions": []
  },
  "roles": [
    {
      "id": "container",
      "locator": { "selector": "#reading-container" },
      "extract": "state"
    },
    {
      "id": "content",
      "locator": { "selector": "#reading-container p" },
      "extract": "text",
      "cardinality": "many",
      "limit": 50
    }
  ],
  "permissions": ["read", "scroll"],
  "procedures": []
}
