{
  "name": "@juho-kim-dev/single-web-use",
  "version": "0.4.0",
  "description": "Guarded viewport observation and reusable site abilities for your open browser",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "swu": "src/cli.js"
  },
  "files": [
    "src/*.js",
    "extension",
    "scripts",
    "test",
    "dist/extension",
    "skills",
    "examples",
    "README.md",
    "README.ko.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "THIRD_PARTY_NOTICES.md",
    "docs"
  ],
  "scripts": {
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.js",
    "start": "node src/cli.js serve"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
